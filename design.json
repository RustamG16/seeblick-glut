{
  "name": "SEEBLICK & GLUT — Fensterplatz",
  "doctrine": "convenium-design-atelier",
  "colors": {
    "paper": "#F3EBDD", "paper-2": "#EAE0CE", "line": "#D8CDBB",
    "ink": "#1A1511", "ink-2": "#5C5149", "ink-3": "#756A5F",
    "night": "#0C0A09", "night-2": "#161210", "paper-dim": "#C9BFAE",
    "ember": "#E85D2F", "ember-hover": "#D5552B"
  },
  "contrast": {
    "ink/paper": 15.30, "ink-2/paper": 6.50, "ink-3/paper": 4.45, "ink/paper-2": 13.85,
    "ink-2/paper-2": 5.88, "ink-3/paper-2": 4.03, "paper/night": 16.69, "paper-dim/night": 10.86,
    "ink/ember": 5.21, "ember/night": 5.68,
    "banned": { "ember-text/paper": 2.94, "paper/ember": 2.94, "ink-2/night": 2.57 }
  },
  "fonts": {
    "display": { "family": "Fraunces Variable", "package": "@fontsource-variable/fraunces", "axes": ["opsz", "wght", "SOFT", "WONK"], "license": "OFL" },
    "text": { "family": "Instrument Sans Variable", "package": "@fontsource-variable/instrument-sans", "license": "OFL" }
  },
  "type": {
    "scale": 1.25,
    "steps_px": [13, 16, 20, 28, 40, 56, 72, 90, 112, 140],
    "rule": "fixed steps per breakpoint; no vw, no clamp",
    "hero":      { "px": { "1280": 140, "900": 112, "600": 72, "0": 56 }, "weight": 400, "lh": 0.95, "ls": "-0.02em", "opsz": 144 },
    "display-1": { "px": { "1280": 72, "900": 56, "0": 40 }, "weight": 400, "lh": 1.05, "ls": "-0.02em", "opsz": 72 },
    "display-2": { "px": { "1280": 56, "900": 40, "600": 32, "0": 28 }, "weight": 400, "lh": 1.05, "ls": "-0.02em" },
    "display-3": { "px": { "900": 28, "600": 24, "0": 22 }, "weight": 500, "lh": 1.2 },
    "pull":      { "px": { "1280": 28, "900": 24, "600": 22, "0": 20 }, "style": "italic", "lh": 1.35, "measure": "34-44ch" },
    "body":      { "px": { "900": 20, "0": 18 }, "weight": 400, "lh": 1.55, "measure": "62-72ch" },
    "label":     { "px": 16, "weight": 500, "lh": 1.35 },
    "meta":      { "px": 13, "weight": 500, "lh": 1.35, "ls": "0.08em", "transform": "uppercase" },
    "price":     { "px": 28, "family": "display", "features": "tnum" }
  },
  "spacing": { "scale": [4, 8, 16, 24, 40, 64, 96, 160], "section": { "desktop": 160, "mobile": 96 }, "gutter": { "desktop": 24, "mobile": 16 }, "margin": { "desktop": 48, "mobile": 24 }, "contentMax": 1280, "columns": { "desktop": 12, "mobile": 6 } },
  "fenster": { "mat": 12, "frame": 1, "radius": 2, "shadow": "none", "ratios": ["3:2", "3:4", "1:1", "4:5"], "maxWidthPx": 840, "innerGround": "night" },
  "motion": { "micro": 160, "move": 600, "scene": 900, "scrub": 1, "easeOut": "cubic-bezier(.16,1,.3,1)", "easeInOut": "cubic-bezier(.65,0,.35,1)", "reduced": "page as printed" },
  "video": { "maxLines": { "desktop": 720, "mobile": 480 }, "maxSeconds": 8, "audio": false, "fullscreen": false, "cropRule": "x + width <= 1620 of 1920 source" },
  "ember_ui_appearances": ["button-primary (header + closing band)", "focus-ring", "hearth-hairline"],
  "breakpoints": [1440, 1280, 900, 600, 390]
}
