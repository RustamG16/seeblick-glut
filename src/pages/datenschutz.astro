---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';

const { datenschutz } = site.legal;
---

<Base title={`${datenschutz.title} — ${site.name}`} description={`Datenschutzerklärung — ${site.name}`} preloadPoster={false}>
  <main id="main">
    <article class="legal">
      <a class="legal__back" href="/">← Zurück</a>
      <h1>{datenschutz.title}</h1>
      {datenschutz.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </section>
      ))}
    </article>
  </main>
  <Footer />
</Base>
