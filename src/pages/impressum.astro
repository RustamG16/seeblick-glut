---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { url } from '../lib/url';
import { site } from '../content/site';

const { impressum } = site.legal;
---

<Base title={`${impressum.title} — ${site.name}`} description={`Impressum und Kontakt — ${site.name}`} preloadPoster={false}>
  <Header home={false} />
  <main id="main">
    <article class="legal">
      <a class="legal__back link t-meta" href={url('/')}>← Zurück</a>
      <h1>{impressum.title}</h1>
      {impressum.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </section>
      ))}
    </article>
  </main>
  <Footer />
</Base>
