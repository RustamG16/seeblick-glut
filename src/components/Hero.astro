---
import { site } from '../content/site';
import Fenster from './Fenster.astro';
import Status from './Status.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid hero__grid">
    <h1 class="hero__title t-wordmark" id="hero-title" data-wordmark aria-label={site.name}>
      <span aria-hidden="true">{site.hero.lines[0]}</span>
      <span aria-hidden="true"><em>{site.hero.lines[1]}</em></span>
      <span aria-hidden="true">{site.hero.lines[2]}</span>
    </h1>
    <div class="hero__aside">
      <p class="t-pull">{site.tagline}</p>
      <div class="hero__chip t-meta">
        <Status />
      </div>
    </div>
    <div class="hero__window">
      <Fenster win={site.windows.glut} eager sizes="(min-width: 900px) 58vw, 100vw" />
    </div>
  </div>
</section>
