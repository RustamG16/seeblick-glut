---
import { site } from '../content/site';
import AmbientVideo from './AmbientVideo.astro';

const { hero, assets, tagline } = site;
const video = assets.heroVideo;
---

<section class="hero" id="hero" aria-label={site.name}>
  <AmbientVideo
    desktop={video.desktop}
    mobile={video.mobile}
    poster={video.poster}
    posterWebp={video.posterWebp}
    fill={true}
    priority={true}
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <h1 class="hero__name display-xl" data-hero-title>
      {hero.lines.map((line) => (
        <span class:list={['hero__line', { 'hero__line--amp': line === '&' }]} data-hero-line>
          {line}
        </span>
      ))}
    </h1>
    <p class="hero__tagline" data-hero-tagline>{tagline}</p>
    <a class="btn btn--solid hero__cta" href={hero.cta.href}>{hero.cta.label}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 35%, transparent) 0%,
      color-mix(in srgb, var(--bg) 55%, transparent) 45%,
      color-mix(in srgb, var(--bg) 80%, transparent) 100%
    );
    pointer-events: none;
    z-index: 3;
  }

  .hero__content {
    position: relative;
    z-index: 4;
    text-align: center;
    padding: 120px 24px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .hero__line {
    display: block;
    overflow: hidden;
  }

  .hero__line--amp {
    font-size: 0.45em;
    font-style: italic;
    letter-spacing: 0.3em;
    color: var(--text-dim);
    margin: 0.1em 0;
  }

  .hero__tagline {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(18px, 2.5vw, 28px);
    color: var(--text-dim);
    letter-spacing: 0.04em;
    max-width: 24ch;
  }

  .hero__cta {
    margin-top: 12px;
  }
</style>
