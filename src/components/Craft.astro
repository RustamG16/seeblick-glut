---
import { site } from '../content/site';
import AmbientVideo from './AmbientVideo.astro';

const { craft, assets } = site;
const video = assets.craftVideo;
---

<section class="craft section" id="craft" aria-labelledby="craft-title">
  <div class="craft__grid section__inner">
    <div class="craft__media">
      <AmbientVideo
        desktop={video.desktop}
        mobile={video.mobile}
        poster={video.poster}
        posterWebp={video.posterWebp}
        lazy={true}
      />
    </div>
    <div class="craft__content">
      <div class="craft__intro">
        <p class="kicker" data-reveal>{craft.kicker}</p>
        <h2 class="display-lg" id="craft-title" data-reveal set:html={craft.headline} />
        <p class="body-lg craft__body" data-reveal>{craft.body}</p>
      </div>
      <ul class="craft__dishes" aria-label="Signaturen">
        {craft.dishes.map((dish) => (
          <li class="craft__dish" data-reveal>
            <div class="craft__dish-head">
              <span class="craft__dish-name">{dish.name}</span>
              <span class="craft__dish-rule" aria-hidden="true"></span>
              <span class="craft__dish-price">{dish.price}</span>
            </div>
            <p class="craft__dish-note">{dish.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .craft__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(48px, 7vw, 96px);
    align-items: start;
  }

  .craft__media {
    position: sticky;
    top: clamp(72px, 12vh, 120px);
  }

  .craft__media :global(.video-wrap) {
    aspect-ratio: 4 / 5;
    border-radius: 2px;
  }

  .craft__content {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 56px);
    padding-top: clamp(0px, 2vw, 24px);
  }

  .craft__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .craft__intro .kicker {
    margin-bottom: 0;
  }

  .craft__body {
    max-width: 46ch;
  }

  .craft__dishes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
  }

  .craft__dish {
    padding: 22px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
  }

  .craft__dish-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 12px;
    font-family: var(--display);
    font-size: clamp(19px, 2.2vw, 24px);
    font-weight: 500;
    line-height: 1.25;
  }

  .craft__dish-rule {
    height: 1px;
    align-self: center;
    background: color-mix(in srgb, var(--text) 10%, transparent);
    min-width: 24px;
  }

  .craft__dish-price {
    color: var(--accent);
    font-size: 0.92em;
    white-space: nowrap;
  }

  .craft__dish-note {
    margin-top: 8px;
    font-size: 13px;
    color: var(--text-dim);
    letter-spacing: 0.03em;
    max-width: 36ch;
  }

  @media (max-width: 900px) {
    .craft__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .craft__media {
      position: static;
    }

    .craft__media :global(.video-wrap) {
      aspect-ratio: 16 / 10;
    }

    .craft__content {
      padding-top: 0;
      gap: 36px;
    }
  }
</style>
