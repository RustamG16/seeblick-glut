---
import { site } from '../content/site';
import Icon from './Icon.astro';
import Status from './Status.astro';
const { practical } = site;
---

<!-- Reservation dock (mobile): the butter ticket, always one thumb away. -->
<div class="dock" data-dock>
  <Status class="dock__status" />
  <a class="dock__cta" href={practical.cta.href}><Icon name="phone" />{practical.cta.label}</a>
</div>
