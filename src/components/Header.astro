---
import { site } from '../content/site';
import { url } from '../lib/url';

// Menu-card masthead row: round "Karte" badge, boxed name, oval reservation button.
interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const to = (hash: string) => (home ? hash : `${url('/')}${hash}`);
---

<header class="header" data-header>
  <a class="header__badge" href={to('#karte')}>Karte</a>
  <a class="header__logo" href={url('/')} aria-label={`${site.name} — Startseite`}>
    <span>Seeblick</span><em>&amp;</em><span>Glut</span>
  </a>
  <a class="header__cta btn btn--oval" href={to('#reservieren')}>Reservieren</a>
</header>
