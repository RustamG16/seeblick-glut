---
import { site } from '../content/site';
import { fit } from '../lib/fit';
import Fenster from './Fenster.astro';
import Engraving from './Engraving.astro';
const { craft, practical, assets } = site;
---

<section class="section glut on-pine" id="glut" aria-labelledby="glut-title" data-glut>
  <div class="wrap">
    <h2 class="title title--butter" style={fit(craft.kicker)} id="glut-title" data-split>{craft.kicker}</h2>
    <p class="glut__head" set:html={craft.headline} data-in="rise" />

    <div class="glut__grid" data-glut-col>
      <div class="glut__hearth">
        <Fenster win={site.windows.herd} decorative sizes="(min-width: 1100px) 620px, 100vw">
          <div class="hearth" data-hearth aria-hidden="true"></div>
          <span slot="mat" class="hearth__line" data-hearth-line aria-hidden="true"></span>
        </Fenster>
      </div>

      <div class="card glut__card" data-in="rise">
        <Engraving src={assets.engravings.holz} class="glut__engr" />
        <p class="card__label">{practical.hours.label}</p>
        <p class="card__big">{practical.hours.lines[1]}</p>
        <p>{practical.hours.lines[0]} · <em>{practical.hours.note}</em></p>
      </div>

      <div class="glut__hands">
        <Fenster win={site.windows.haende} sizes="(min-width: 1100px) 420px, 100vw" />
      </div>
    </div>
  </div>
</section>
