---
import { site } from '../content/site';

const { practical } = site;

const blocks = [
  {
    label: practical.hours.label,
    lines: practical.hours.lines,
    note: practical.hours.note,
  },
  {
    label: practical.address.label,
    lines: practical.address.lines,
    link: { label: practical.address.mapLabel, href: practical.address.mapUrl, external: true },
  },
  {
    label: practical.parking.label,
    lines: practical.parking.lines,
    note: practical.parking.note,
  },
  {
    label: practical.contact.label,
    lines: [],
    link: { label: practical.contact.phone, href: practical.contact.phoneHref, external: false },
    note: practical.contact.note,
  },
];
---

<section class="practical section" id="practical" aria-labelledby="practical-title">
  <div class="section__inner">
    <p class="kicker" data-reveal>{practical.kicker}</p>
    <h2 class="display-lg practical__title" id="practical-title" data-reveal>
      {practical.title}
    </h2>
    <div class="practical__grid">
      {blocks.map((block, i) => (
        <div class="practical__block" data-reveal>
          <p class="practical__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="practical__label">{block.label}</h3>
          {block.lines.map((line) => <p>{line}</p>)}
          {block.link && (
            <a
              class="practical__link"
              href={block.link.href}
              {...(block.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {block.link.label}
            </a>
          )}
          {block.note && <p class="practical__muted">{block.note}</p>}
        </div>
      ))}
    </div>
    <div class="practical__reserve" data-reveal>
      <div class="practical__reserve-main">
        <a class="practical__reserve-cta" href={practical.cta.href}>
          <span class="practical__reserve-text">{practical.cta.label}</span>
          <span class="practical__reserve-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <p class="practical__reserve-phone">
          <a href={practical.contact.phoneHref}>{practical.contact.phone}</a>
        </p>
      </div>
      <div class="practical__reserve-aside">
        <p class="practical__tasting">{practical.tastingMenu}</p>
        <p class="practical__reserve-sub">{practical.cta.sub}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .practical__title {
    margin-bottom: clamp(48px, 7vw, 80px);
  }

  .practical__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(28px, 4vw, 48px);
  }

  .practical__block {
    border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    padding-top: 20px;
  }

  .practical__index {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .practical__label {
    font-family: var(--display);
    font-size: 19px;
    font-weight: 500;
    margin-bottom: 12px;
    letter-spacing: 0.06em;
  }

  .practical__block p {
    color: var(--text-dim);
    font-size: 15px;
    margin-bottom: 4px;
  }

  .practical__muted {
    font-size: 13px;
    margin-top: 10px !important;
    opacity: 0.75;
    max-width: 26ch;
  }

  .practical__link {
    display: inline-block;
    margin-top: 10px;
    padding: 6px 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--accent);
    transition: color 0.2s ease;
  }

  .practical__link:hover,
  .practical__link:focus-visible {
    color: var(--accent);
  }

  /* ---- closing reservation band ---- */
  .practical__reserve {
    margin-top: clamp(72px, 10vw, 128px);
    padding: clamp(40px, 6vw, 64px) 0;
    border-top: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: end;
  }

  .practical__reserve-cta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(34px, 5.5vw, 72px);
    line-height: 1.05;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .practical__reserve-arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.3s ease;
  }

  .practical__reserve-cta:hover,
  .practical__reserve-cta:focus-visible {
    color: var(--accent);
  }

  .practical__reserve-cta:hover .practical__reserve-arrow,
  .practical__reserve-cta:focus-visible .practical__reserve-arrow {
    transform: translateX(0.25em);
  }

  .practical__reserve-phone {
    margin-top: 18px;
  }

  .practical__reserve-phone a {
    display: inline-block;
    padding: 6px 0;
    font-size: clamp(15px, 1.8vw, 18px);
    letter-spacing: 0.12em;
    color: var(--text-dim);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .practical__reserve-phone a:hover,
  .practical__reserve-phone a:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .practical__reserve-aside {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .practical__tasting {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text);
  }

  .practical__reserve-sub {
    color: var(--text-dim);
    max-width: 38ch;
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 1000px) {
    .practical__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(32px, 5vw, 48px);
    }
  }

  @media (max-width: 760px) {
    .practical__reserve {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 32px;
    }
  }

  @media (max-width: 560px) {
    .practical__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
