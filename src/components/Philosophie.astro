---
import { site } from '../content/site';
import Fenster from './Fenster.astro';
const { philosophy } = site;
---

<section class="section philo" id="philosophie" aria-labelledby="philo-title">
  <div class="wrap philo__grid">
    <div class="panel panel--lake philo__panel" data-in="wipe">
      <p class="box__label box__label--cream">{philosophy.kicker} <span class="box__rule" aria-hidden="true" /></p>
      <h2 class="philo__title" id="philo-title" data-split>{philosophy.headline}</h2>
      <p class="dropcap dropcap--cream philo__body">{philosophy.body}</p>
    </div>
    <div class="philo__plate">
      <Fenster win={site.windows.feuer} sizes="(min-width: 1100px) 420px, 100vw" />
    </div>
  </div>
</section>
