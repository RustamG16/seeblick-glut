---
import { site } from '../content/site';
import { url } from '../lib/url';
const { footer } = site;
---

<footer class="footer on-night">
  <div class="wrap footer__row">
    <span class="footer__mark">SEEBLICK <em>&amp;</em> GLUT</span>
    <span class="t-meta">{footer.line}</span>
    <span class="t-meta">{footer.copyright}</span>
    <nav class="footer__links t-meta" aria-label="Rechtliches">
      <a class="link" href={url('/impressum')}>{footer.impressumLabel}</a>
      <a class="link" href={url('/datenschutz')}>{footer.datenschutzLabel}</a>
    </nav>
  </div>
</footer>
