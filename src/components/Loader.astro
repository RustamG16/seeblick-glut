---
import { site } from '../content/site';
import { url } from '../lib/url';
// The intro is the card being printed: the Remotion wordmark (cream, red, butter stamp) plays
// once per session, then the card lifts off the page. Skipped for reduced motion / repeat visits.
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__stage">
    <video
      class="loader__mark"
      muted
      playsinline
      preload="none"
      width="1600"
      height="560"
      data-loader-video
      data-src={url(site.assets.intro)}
    ></video>
    <p class="loader__fallback">Seeblick <em>&amp;</em> Glut</p>
  </div>
  <span class="loader__bar"><span data-loader-bar></span></span>
</div>
