---
import { site } from '../content/site';
import { fit } from '../lib/fit';
import Fenster from './Fenster.astro';
import Engraving from './Engraving.astro';
import Icon from './Icon.astro';
const { practical, assets } = site;
const { hours, address, parking, contact } = practical;
---

<section class="section besuch" id="practical" aria-labelledby="besuch-title">
  <div class="wrap">
    <div class="besuch__head">
      <h2 class="title title--lake" style={fit(practical.title)} id="besuch-title" data-split>{practical.title}</h2>
      <Engraving src={assets.engravings.see} class="besuch__engr" />
    </div>

    <div class="cols">
      <div class="col" data-in="rise">
        <p class="col__label"><Icon name="clock" />{hours.label}</p>
        <p>{hours.lines[0]}<br />{hours.lines[1]}</p>
        <p class="col__note">{hours.note}</p>
      </div>
      <div class="col" data-in="rise">
        <p class="col__label"><Icon name="pin" />{address.label}</p>
        <p>{address.lines[0]}<br />{address.lines[1]}</p>
        <a class="link" href={address.mapUrl} rel="noopener" target="_blank">{address.mapLabel}</a>
      </div>
      <div class="col" data-in="rise">
        <p class="col__label"><Icon name="car" />{parking.label}</p>
        <p>{parking.lines[0]}</p>
        <p class="col__note">{parking.note}</p>
      </div>
      <div class="col" data-in="rise">
        <p class="col__label"><Icon name="phone" />{contact.label}</p>
        <a class="col__phone" href={contact.phoneHref}>{contact.phone}</a>
        <p class="col__note">{contact.note}</p>
      </div>
    </div>

    <div class="besuch__plate">
      <Fenster win={site.windows.ankunft} sizes="(min-width: 1100px) 1240px, 100vw" />
    </div>
  </div>
</section>
